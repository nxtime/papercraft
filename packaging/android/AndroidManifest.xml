<?xml version="1.0" encoding="utf-8"?>
<!-- PaperCraft for Android: PaperActivity (a GameActivity, packaging/android/java) loads libpapercraft_android.so (apps/android). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.marcospaulo.papercraft"
    android:versionCode="VERSION_CODE"
    android:versionName="VERSION_NAME">

    <!-- Target 35: the window is edge to edge from API 30 (GameActivity); PaperActivity reports the
         system bar, cutout and keyboard insets and the app keeps clear of them. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <!-- Kept for the relay sync that comes next; nothing in the app uses the network yet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="PaperCraft"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:allowBackup="false">
        <activity
            android:name=".PaperActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="papercraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
